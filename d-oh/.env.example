# ---------------------------------------------------------------------------
# D-OH — variáveis de ambiente (copiar para .env)
# ---------------------------------------------------------------------------

# Ledger Indy usado pelos agentes ACA-Py (ver ledger/README.md).
# Default: ledger publico de testes (apenas para dev). Em producao/homologacao
# apontar para a rede permissionada real (Rede Blockchain Brasil / Indy-Besu).
GENESIS_URL=http://192.168.0.21:9000/genesis

TAILS_SERVER_URL=http://tails-server:6543

IPFS_API_URL=http://ipfs:5001
IPFS_GATEWAY_URL=http://ipfs:8081

# --- Chaves de wallet (DEV ONLY — em producao usar secrets manager) --------
TRUST_ANCHOR_WALLET_KEY=change-me-trust-anchor
ISSUER_HOSPITAL_WALLET_KEY=change-me-hospital
ISSUER_CLINIC_WALLET_KEY=change-me-clinic
ISSUER_LAB_WALLET_KEY=change-me-lab
VERIFIER_MEDICO_WALLET_KEY=change-me-verifier
HOLDER_HEALTHDID_WALLET_KEY=change-me-holder

# --- SEEDS DE WALLET -----
TRUST_ANCHOR_SEED=0f12f70eef23f53270dca28f7df88b4a
ISSUER_CLINIC_SEED=60b725f10c9c85c70d97880dfe8191b3
ISSUER_HOSPITAL_SEED=3b5d5c3712955042212316173ccf37be


# --- Admin API keys (DEV ONLY — agentes sobem com admin-insecure-mode) -----
TRUST_ANCHOR_ADMIN_API_KEY=trust-anchor-admin-key
ISSUER_HOSPITAL_ADMIN_API_KEY=issuer-hospital-admin-key
ISSUER_CLINIC_ADMIN_API_KEY=issuer-clinic-admin-key
ISSUER_LAB_ADMIN_API_KEY=issuer-lab-admin-key
VERIFIER_MEDICO_ADMIN_API_KEY=verifier-medico-admin-key
HOLDER_HEALTHDID_ADMIN_API_KEY=holder-healthdid-admin-key

# --- Portas dos agentes (inbound DIDComm / admin API) -----------------------
TRUST_ANCHOR_INBOUND_PORT=8020
TRUST_ANCHOR_ADMIN_PORT=8021
ISSUER_HOSPITAL_INBOUND_PORT=8030
ISSUER_HOSPITAL_ADMIN_PORT=8031
ISSUER_CLINIC_INBOUND_PORT=8040
ISSUER_CLINIC_ADMIN_PORT=8041
ISSUER_LAB_INBOUND_PORT=8050
ISSUER_LAB_ADMIN_PORT=8051
VERIFIER_MEDICO_INBOUND_PORT=8060
VERIFIER_MEDICO_ADMIN_PORT=8061
HOLDER_HEALTHDID_INBOUND_PORT=8070
HOLDER_HEALTHDID_ADMIN_PORT=8071

# --- Servicos de aplicacao ---------------------------------------------------
FHIR_VC_BRIDGE_PORT=9005
IPFS_ANCHOR_PORT=9001
TRUST_REGISTRY_PORT=9002
KEY_ESCROW_PORT=9003
ADMIN_CONSOLE_PORT=9010

# KEK (Key Encryption Key) do key-escrow do emissor "Hospital" — AES-256
# em base64 (32 bytes). DEV ONLY: gerar com `openssl rand -base64 32`.
# Em producao, delegar a um KMS/HSM (ver services/key-escrow/app/crypto.py)
# — nunca reaproveitar esta chave, nem entre ambientes, nem entre emissores.
KEY_ESCROW_HOSPITAL_MASTER_KEY=change-me-run-openssl-rand-base64-32
